# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
*
!/src/
!/src/**
!/public/
!/public/**
!package.json
!.gitignore
!.env.production
!/documentation/
!/documentation/**
!/CLAUDE.md
!/DECISION-PRINCIPLES.md
!/SPEC-PRINCIPLES.md

# A captured portfolio is a LEDGER. The allowlist above admits everything under /src/, so it has to be
# excluded by name or a `git add src/` commits every transaction the user has.
/src/tests/fixtures/*.json

# The generated audit pages embed every account name, partition and transaction date in the captured
# ledger. The allowlist above admits everything under /src/, so each has to be excluded by name.
/src/processors/streamPredictor/audit-account-mapping.html
/src/processors/streamPredictor/audit-cycle.html
/src/processors/streamPredictor/audit-cycle-fit.html
/src/processors/streamPredictor/audit-modes.html
/src/processors/streamPredictor/audit-prediction.html
