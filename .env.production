# Production builds skip the ESLint webpack plugin.
#
# No lockfile is committed (see .gitignore), so a cache-less CI build re-resolves
# the whole dependency tree from the semver ranges in package.json. One of the
# transitive eslint packages under react-scripts now resolves to a version that
# no longer registers the "jest/globals" environment, which the react-app/jest
# preset still asks for, and the build fails before compiling any of our code.
#
# Linting is not needed to produce a bundle. This file is .env.production rather
# than .env on purpose: it applies to `npm run build` only, so `npm start` keeps
# reporting lint errors in the dev overlay.
DISABLE_ESLINT_PLUGIN=true
